<%
  // Cabecera compartida de las páginas de error (403, 404).
  // Muestra la navegación y las acciones según el rol de la sesión.
  // La sesión llega como la variable «session» (res.locals.session, ver
  // configs/middlewares.js · viewSession). Dentro de un include de ejs-mate
  // «locals» no es el mismo objeto de la página, por eso se lee primero «session».
  const ses = (typeof session !== 'undefined' && session) || locals.session || {}
  const rol = ses.role
  const sesionUser = ses.user
  const tieneNombre = sesionUser && sesionUser.nombres && sesionUser.apellidos
  const cuentaHref = rol === 'manager' ? '/manager/cuenta' : '/student/cuenta'
%>

<header class="error-header">

  <div class="error-header-content">

    <a href="/public" class="error-brand">
      <span class="error-logo"></span>
      <span>Almacén de Equipos</span>
    </a>


    <% if (rol === 'student') { %>

      <nav class="error-nav">
        <a href="/student/cuenta">Mi cuenta</a>
      </nav>

    <% } else if (rol === 'manager') { %>

      <nav class="error-nav">
        <a href="/manager/inventario">Inventario</a>
      </nav>

    <% } else { %>

      <nav class="error-nav">
        <a href="/public">Inicio</a>
        <a href="/public/reglas">Reglas del préstamo</a>
        <a href="/public/ayuda">Ayuda</a>
      </nav>

    <% } %>


    <% if (rol === 'student' || rol === 'manager') { %>

      <!-- Con sesión: usuario + Mi cuenta + Salir (igual que en layouts.jsx) -->
      <div class="error-user">

        <div class="error-user-text">
          <strong>
            <% if (tieneNombre) { %>
              <%= sesionUser.nombres %> <%= sesionUser.apellidos %>
            <% } else { %>
              <%= ses.username %>
            <% } %>
          </strong>
          <span><%= rol === 'student' ? 'Estudiante' : 'Encargado de almacén' %></span>
        </div>

        <div class="error-avatar">
          <% if (tieneNombre) { %>
            <%= sesionUser.nombres.charAt(0).toUpperCase() %><%= sesionUser.apellidos.charAt(0).toUpperCase() %>
          <% } else { %>
            <%= String(ses.username || 'U').charAt(0).toUpperCase() %>
          <% } %>
        </div>

        <div class="error-account-actions">
          <a href="<%= cuentaHref %>" class="error-login">Mi cuenta</a>
          <a href="/logout-project" class="error-register">Salir</a>
        </div>

      </div>

    <% } else { %>

      <!-- Sin sesión -->
      <div class="error-public-actions">
        <a href="/public/login" class="error-login">Iniciar sesión</a>
        <a href="/public/register" class="error-register">Crear cuenta</a>
      </div>

    <% } %>

  </div>

</header>
